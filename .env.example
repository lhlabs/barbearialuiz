# Public browser configuration only. These values are not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

# Strongly recommended in production. Configure App Check for the GitHub Pages domain first.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Activate only after publishing the repository's firestore.rules and setting
# settings/general.abuseGuardRequired=true in Firestore.
NEXT_PUBLIC_FIREBASE_ABUSE_GUARD_ENABLED=false

# Only needed when publishing under a GitHub Pages repository subpath.
NEXT_PUBLIC_BASE_PATH=/YOUR_REPOSITORY

# Nunca adicione service account, private key, token privilegiado ou senha administrativa.
