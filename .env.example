# Public browser configuration only. These values are not secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Only needed when publishing under a GitHub Pages repository subpath.
NEXT_PUBLIC_BASE_PATH=/YOUR_REPOSITORY

# Never add SUPABASE_SECRET_KEY, service_role, database passwords or admin passwords here.

